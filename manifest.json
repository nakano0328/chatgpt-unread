{
  "manifest_version": 3,
  "name": "ChatGPT Unread",
  "version": "0.1.1",
  "description": "ChatGPT の回答完了を「未確認」として残し、確認するまで一覧に表示します。",
  "permissions": ["storage"],
  "host_permissions": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ChatGPT 未確認"
  }
}
